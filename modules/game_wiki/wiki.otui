WikiButton < Button
  size: 190 36
  font: verdana-11px-rounded
  text-align: center
  text-wrap: true

WikiRow < Panel
  height: 40
  layout:
    type: horizontalBox
    spacing: 8
    align-items: flex-start
  margin-top: 2
  margin-bottom: 2

MainWindow
  id: wikiWindow
  !text: tr('Wiki')
  size: 680 520
  @onEscape: modules.game_wiki.backOrClose()
  $mobile:
    size: 360 450

  Panel
    id: listPanel
    anchors.fill: parent

    Label
      id: titleLabel
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      height: 24
      text-align: center
      !text: tr('Escolha um tópico para ver mais informações')
      font: verdana-11px-rounded
      color: orange

    VerticalScrollBar
      id: topicsScrollBar
      anchors.top: topicsScrollPanel.top
      anchors.bottom: topicsScrollPanel.bottom
      anchors.right: parent.right
      margin-right: 2
      step: 40
      pixels-scroll: true

    ScrollablePanel
      id: topicsScrollPanel
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: topicsScrollBar.left
      anchors.bottom: closeButton.top
      margin-top: 8
      margin-bottom: 12
      margin-right: 6
      vertical-scrollbar: topicsScrollBar
      layout:
        type: verticalBox
        spacing: 2
        fit-children: true
      padding-right: 4

    Button
      id: closeButton
      !text: tr('Fechar')
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      width: 85
      height: 28
      margin-top: 4
      @onClick: modules.game_wiki.hide()

  Panel
    id: detailPanel
    anchors.fill: parent
    visible: false

    Label
      id: detailTitle
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      height: 26
      text-align: center
      font: verdana-11px-rounded
      color: orange
      !text: tr('Detalhes')

    HorizontalSeparator
      id: sep
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 2
      margin-bottom: 4

    VerticalScrollBar
      id: detailScrollBar
      anchors.top: detailScrollPanel.top
      anchors.bottom: detailScrollPanel.bottom
      anchors.right: parent.right
      margin-right: 2
      step: 28
      pixels-scroll: true

    ScrollablePanel
      id: detailScrollPanel
      anchors.top: sep.bottom
      anchors.left: parent.left
      anchors.right: detailScrollBar.left
      anchors.bottom: buttonsPanel.top
      margin-top: 4
      margin-bottom: 8
      margin-right: 6
      vertical-scrollbar: detailScrollBar
      padding: 6
      padding-right: 12

      Label
        id: detailText
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right
        text-wrap: true
        text-auto-resize: true
        font: verdana-11px-rounded
        color: #E0E0E0

    Panel
      id: buttonsPanel
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      height: 34

      Button
        id: backButton
        !text: tr('Voltar')
        anchors.left: parent.left
        anchors.bottom: parent.bottom
        width: 90
        height: 26
        @onClick: modules.game_wiki.showList()

      Button
        id: closeDetailButton
        !text: tr('Fechar')
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        width: 90
        height: 26
        @onClick: modules.game_wiki.hide()
