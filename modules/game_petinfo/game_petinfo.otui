// --- ESTILOS ---
StatLabel < Label
  font: verdana-11px-rounded
  color: #aaaaaa
  anchors.left: parent.left
  anchors.verticalCenter: parent.verticalCenter
  text-auto-resize: true

StatValue < Label
  font: verdana-11px-rounded
  color: #ffffff
  anchors.right: parent.right
  anchors.verticalCenter: parent.verticalCenter
  text-align: right
  text-auto-resize: true

StatRow < UIWidget
  height: 18
  margin-left: 10
  margin-right: 10

SectionTitle < Label
  font: verdana-11px-rounded
  color: #55ffff
  text-align: center
  height: 15
  margin-top: 3
  margin-bottom: 3

HSeparator < UIWidget
  height: 1
  background-color: #ffffff
  opacity: 0.1
  margin-top: 3
  margin-bottom: 3

NavButton < UIButton
  size: 20 40
  color: #ffffff
  font: verdana-11px-rounded
  background-color: #00000088
  anchors.verticalCenter: parent.verticalCenter
  $hover:
    color: #ffcc00
    background-color: #000000aa

ActionButton < Button
  height: 24
  font: verdana-11px-rounded
  color: #ffffff
  background-color: #333333
  border-width: 1
  border-color: #555555
  $hover:
    background-color: #444444
    border-color: #888888
  $disabled:
    color: #555555
    background-color: #222222
    border-color: #333333

// --- JANELA ---
MainWindow
  id: petWindow
  size: 350 580
  padding: 0
  background-color: #181818
  border-width: 1
  border-color: #444444
  draggable: true
  focusable: false
  phantom: false

  // BOTOES DE CONTROLE
  UIButton
    id: closeBtnX
    anchors.top: parent.top
    anchors.right: parent.right
    margin: 5
    size: 12 12
    text: X
    font: verdana-11px-rounded
    color: #ff5555
    background-color: #00000088
    z-index: 10

  UIButton
    id: minBtn
    anchors.top: parent.top
    anchors.right: closeBtnX.left
    margin-top: 5
    margin-right: 5
    size: 12 12
    text: -
    font: verdana-11px-rounded
    color: #ffff55
    background-color: #00000088
    z-index: 10

  // === PAINEL COMPACTO (Oculto por padrão) ===
  Panel
    id: compactPanel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 28
    margin-top: 26
    margin-left: 10
    margin-right: 10
    visible: false
    layout: 
      type: horizontalBox
      spacing: 4

    ActionButton
      id: compactSummonBtn
      text: Invocar
      width: 80
      color: #aaffaa

    ActionButton
      id: compactHealBtn
      text: Heal
      width: 70
      color: #aaffaa

    ActionButton
      id: compactReviveBtn
      text: Revive
      width: 70
      color: #aaaaff

    ActionButton
      id: compactMountBtn
      text: Mount
      width: 70
      color: #ffffaa

  // === 1. HEADER ===
  UIWidget
    id: headerPanel
    size: 320 300
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 20
    image-source: /game_petinfo/images/scene
    border: 1 #000000

    UIWidget
      id: petImage
      anchors.centerIn: parent
      size: 69 69

    UICreature
      id: creature
      anchors.centerIn: petImage
      size: 69 69
      fixed-creature-size: true
      phantom: true
      visible: false 

    NavButton
      id: prevBtn
      anchors.left: parent.left
      text: <
      margin-left: 5

    NavButton
      id: nextBtn
      anchors.right: parent.right
      text: >
      margin-right: 5

    // CAIXA DE NOME
    UIWidget
      id: namePlate
      anchors.bottom: petImage.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-bottom: 5
      width: 150
      height: 40
      background-color: #00000088
      border-radius: 5

      Label
        id: nameLabel
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 5
        font: verdana-11px-rounded
        color: #ffffff
        text: Unknown
        text-shadow: #000000
        text-align: center

      Label
        id: rankLabel
        anchors.top: nameLabel.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 2
        font: verdana-11px-rounded
        color: #ffcc00
        text: (Rank)
        text-shadow: #000000
        text-align: center

    // CONTADOR DE PETS
    Label
      id: petCounter
      anchors.bottom: parent.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-bottom: 5
      font: verdana-11px-rounded
      color: #ffffff
      background-color: #00000088
      text: 1 / 1
      text-align: center
      padding: 3 8 3 8

  // === 2. LISTA BÁSICA ===
  Panel
    id: basicPanel
    anchors.top: headerPanel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 60
    margin-top: 5
    layout: verticalBox

    StatRow
      id: rowHp
      StatLabel
        text: Health
      StatValue
        id: val
        text: 0/0
        color: #ff5555

    StatRow
      id: rowLvl
      StatLabel
        text: Level
      StatValue
        id: val
        text: 0
        color: #ffffff

    StatRow
      id: rowExp
      StatLabel
        text: Total Exp
      StatValue
        id: val
        text: 0
        color: #aaffaa

  HSeparator
    id: sep1
    anchors.top: basicPanel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-left: 10
    margin-right: 10

  // === 3. GENÉTICA (IVs) ===
  SectionTitle
    id: titleIv
    text: Genetica (IVs)
    anchors.top: sep1.bottom
    anchors.left: parent.left
    anchors.right: parent.right

  Panel
    id: ivPanel
    anchors.top: titleIv.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 80
    margin-left: 5
    margin-right: 5
    
    Panel
      id: leftIv
      anchors.left: parent.left
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      width: 165
      layout: verticalBox

      StatRow
        id: rowIvHp
        StatLabel
          text: Vida
        StatValue
          id: val
          text: 0

      StatRow
        id: rowIvDef
        StatLabel
          text: Defesa
        StatValue
          id: val
          text: 0
          
      StatRow
        id: rowIvRes
        StatLabel
          text: Resistencias
        StatValue
          id: val
          text: 0

      StatRow
        id: rowIvVit
        StatLabel
          text: Vitalidade
        StatValue
          id: val
          text: 0

    Panel
      id: rightIv
      anchors.right: parent.right
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      width: 165
      layout: verticalBox

      StatRow
        id: rowIvAtk
        StatLabel
          text: Ataque
        StatValue
          id: val
          text: 0

      StatRow
        id: rowIvSpd
        StatLabel
          text: Movimento
        StatValue
          id: val
          text: 0
          
      StatRow
        id: rowIvExp
        StatLabel
          text: Ganho de Exp
        StatValue
          id: val
          text: 0%

  // === 4. BOTÕES DE AÇÃO ===
  Panel
    id: actionPanel
    anchors.top: ivPanel.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    height: 28
    width: 310
    margin-top: 8
    layout: 
      type: horizontalBox
      spacing: 6

    ActionButton
      id: healBtn
      text: Heal
      width: 72
      color: #aaffaa

    ActionButton
      id: reviveBtn
      text: Revive
      width: 72
      color: #aaaaff

    ActionButton
      id: mountBtn
      text: Mount
      width: 72
      color: #ffffaa

    ActionButton
      id: releaseBtn
      text: Release
      width: 72
      color: #ffaaaa

  Button
    id: selectBtn
    text: SELECIONAR
    anchors.top: actionPanel.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 8
    width: 320
    height: 28
    color: #aaffaa
    background-color: #222222